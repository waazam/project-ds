; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project DS"
config/description="Third-person psychological horror. Working title."
run/main_scene="res://scenes/ui/startup_logo.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/3d_panning_strength=0.9

[autoload]

GameSettings="*res://scripts/systems/GameSettings.cs"
StoryManager="*res://scripts/systems/StoryManager.cs"
AudioDirector="*res://scripts/audio/AudioDirector.cs"
PostGuard="*res://scripts/ui/PostGuard.cs"
SaveIndicator="*res://scripts/ui/SaveIndicator.cs"
CinemaFrame="*res://scripts/ui/CinemaFrame.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="ProjectDS"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Triggers"
3d_physics/layer_4="Interactables"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.16, 0.18, 0.17, 1)
lights_and_shadows/positional_shadow/atlas_size=4096
textures/default_filters/texture_mipmap_bias=-0.5
scaling_3d/mode=0
scaling_3d/scale=1.5
mesh_lod/lod_change/threshold_pixels=0.5
anti_aliasing/quality/screen_space_aa=0

[shader_globals]

uv_light_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
uv_light_dir={
"type": "vec3",
"value": Vector3(0, 0, -1)
}
uv_light_on={
"type": "float",
"value": 0.0
}
uv_light_range={
"type": "float",
"value": 9.0
}
winter={
"type": "float",
"value": 0.0
}

[editor]

movie_writer/mjpeg_quality=0.95
